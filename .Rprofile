source("renv/activate.R")

# Print welcome message
.First <- function() {
  if (interactive()) {
    message("===============================================")
    message("  TB-PAXGENE Analysis Environment")
    message("===============================================")
    message("Configuration: config.R")
    message("Documentation: See README.md and CONTRIBUTING.md")
    message("Code style: Run lintr::lint_dir() to check")
    message("===============================================")
  }
}

